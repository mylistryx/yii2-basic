#!/usr/bin/env php
<?php
/**
 * Yii Application Initialization Tool
 *
 * In order to run in non-interactive mode:
 *
 * init --env=Development --overwrite=n
 */
require_once 'vendor/autoload.php';

use yii\helpers\Console;
use yii\helpers\FileHelper;

if (!extension_loaded('openssl')) {
    die('The OpenSSL PHP extension is required by Yii2.');
}

$params = getParams();
$root = str_replace('\\', '/', __DIR__);
$envs = require "$root/environments/index.php";
$envNames = array_keys($envs);

printMessage("Yii Application Initialization Tool v1.0" . PHP_EOL . PHP_EOL);

$envName = null;
if (empty($params['env']) || $params['env'] === true) {
    printMessage("Which environment do you want the application to be initialized in?" . PHP_EOL . PHP_EOL);
    foreach ($envNames as $i => $name) {
        printMessage("  [$i] $name" . PHP_EOL);
    }
    printMessage(PHP_EOL . "  Your choice [0-" . (count($envs) - 1) . ', or "q" to quit] ');
    $answer = trim(fgets(STDIN));

    if (!ctype_digit($answer) || !in_array($answer, range(0, count($envs) - 1))) {
        printMessage(PHP_EOL . "  Quit initialization." . PHP_EOL);
        exit(0);
    }

    if (isset($envNames[$answer])) {
        $envName = $envNames[$answer];
    }
} else {
    $envName = $params['env'];
}

if (!in_array($envName, $envNames, true)) {
    $envsList = implode(', ', $envNames);
    printMessage(PHP_EOL . "  $envName is not a valid environment. Try one of the following: $envsList. " . PHP_EOL);
    exit(2);
}

$env = $envs[$envName];

if (empty($params['env'])) {
    printMessage(PHP_EOL . "  Initialize the application under '{$envNames[$answer]}' environment? [yes|no] ");
    $answer = trim(fgets(STDIN));
    if (strncasecmp($answer, 'y', 1)) {
        printMessage(PHP_EOL . "  Quit initialization." . PHP_EOL);
        exit(0);
    }
}

$rootPath = "$root/environments/{$env['path']}";
if (!is_dir($rootPath)) {
    printError("$rootPath directory does not exist. Check path in $envName environment.");
    exit(3);
}

printMessage(PHP_EOL . "  Start initialization ..." . PHP_EOL . PHP_EOL);

$files = getFileList($rootPath);
if (isset($env['skipFiles'])) {
    $skipFiles = $env['skipFiles'];
    array_walk($skipFiles, function (&$value) use ($env, $root) {
        $value = "$root/$value";
    });
    $files = array_filter($skipFiles, 'file_exists')
            |> (fn($x) => array_intersect_key($env['skipFiles'], $x))
            |> (fn($x) => array_diff($files, $x));
}
$all = false;
foreach ($files as $file) {
    if (!copyFile($root, "environments/{$env['path']}/$file", $file, $all, $params)) {
        break;
    }
}

$filesToRemove = [];
$skipFiles = !empty($env['skipFiles']) ? $env['skipFiles'] : [];
foreach (array_column($envs, 'path') as $envPath) {
    if ($env['path'] === $envPath) continue;

    $filesToRemove =
        "$root/environments/{$envPath}"
            |> getFileList(...)
            |> (fn($x) => array_diff($x, $files, $filesToRemove, $skipFiles))
            |> (fn($x) => array_merge($filesToRemove, $x));
}
$filesToRemove = array_filter($filesToRemove, 'file_exists');
if ($filesToRemove) {
    printMessage(PHP_EOL . "  Remove files from other environments ..." . PHP_EOL . PHP_EOL);

    $all = false;
    foreach ($filesToRemove as $file) {
        if (!removeFile($root, $file, $all, $params)) {
            break;
        }
    }
    printMessage(PHP_EOL);
}

$callbacks = ['setCookieValidationKey', 'setWritable', 'setExecutable', 'createSymlink'];
foreach ($callbacks as $callback) {
    if (!empty($env[$callback])) {
        $callback($root, $env[$callback]);
    }
}

printMessage(PHP_EOL . "  ... initialization completed." . PHP_EOL . PHP_EOL);

function getFileList($root, $basePath = ''): array
{
    $files = [];
    $handle = opendir($root);
    while (($path = readdir($handle)) !== false) {
        if ($path === '.git' || $path === '.svn' || $path === '.' || $path === '..') {
            continue;
        }
        $fullPath = "$root/$path";
        $relativePath = $basePath === '' ? $path : "$basePath/$path";
        if (is_dir($fullPath)) {
            $files = array_merge($files, getFileList($fullPath, $relativePath));
        } else {
            $files[] = $relativePath;
        }
    }
    closedir($handle);
    return $files;
}

/**
 * @throws \yii\base\Exception
 */
function copyFile($root, $source, $target, &$all, $params): bool
{
    if (!is_file($root . '/' . $source)) {
        printMessage("       skip $target ($source not exist)" . PHP_EOL);
        return true;
    }
    if (is_file($root . '/' . $target)) {
        if (file_get_contents($root . '/' . $source) === file_get_contents($root . '/' . $target)) {
            printMessage("  unchanged $target" . PHP_EOL);
            return true;
        }
        if ($all) {
            printMessage("  overwrite $target" . PHP_EOL);
        } else {
            printMessage("      exist $target" . PHP_EOL);
            printMessage("            ...overwrite? [Yes|No|All|Quit] ");


            $answer = !empty($params['overwrite']) ? $params['overwrite'] : trim(fgets(STDIN));
            if (!strncasecmp($answer, 'q', 1)) {
                return false;
            } else {
                if (!strncasecmp($answer, 'y', 1)) {
                    printMessage("  overwrite $target" . PHP_EOL);
                } else {
                    if (!strncasecmp($answer, 'a', 1)) {
                        printMessage("  overwrite $target" . PHP_EOL);
                        $all = true;
                    } else {
                        printMessage("       skip $target" . PHP_EOL);
                        return true;
                    }
                }
            }
        }
        file_put_contents($root . '/' . $target, file_get_contents($root . '/' . $source));
        return true;
    }
    printMessage("   generate $target" . PHP_EOL);
    FileHelper::createDirectory($root . '/' . $target, 0777, true);
    file_put_contents($root . '/' . $target, file_get_contents($root . '/' . $source));
    return true;
}

function removeFile($root, $target, &$all, $params): bool
{
    if (is_file($root . '/' . $target)) {
        if ($all) {
            printMessage("  delete $target" . PHP_EOL);
        } else {
            printMessage("      delete $target" . PHP_EOL);
            printMessage("            ...confirm? [Yes|No|All|Quit]");

            $answer = !empty($params['delete']) ? $params['delete'] : trim(fgets(STDIN));
            if (!strncasecmp($answer, 'q', 1)) {
                return false;
            } else {
                if (!strncasecmp($answer, 'y', 1)) {
                    printMessage("  delete $target" . PHP_EOL);
                } else {
                    if (!strncasecmp($answer, 'a', 1)) {
                        printMessage("  delete $target" . PHP_EOL);
                        $all = true;
                    } else {
                        printMessage("       skip $target" . PHP_EOL);
                        return true;
                    }
                }
            }
        }
        return unlink($root . '/' . $target);
    }

    return true;
}

function getParams(): array
{
    $rawParams = [];
    if (isset($_SERVER['argv'])) {
        $rawParams = $_SERVER['argv'];
        array_shift($rawParams);
    }

    $params = [];
    foreach ($rawParams as $param) {
        if (preg_match('/^--([\w-]*\w)(=(.*))?$/', $param, $matches)) {
            $name = $matches[1];
            $params[$name] = isset($matches[3]) ? $matches[3] : true;
        } else {
            $params[] = $param;
        }
    }
    return $params;
}

function setWritable($root, $paths): void
{
    foreach ($paths as $writable) {
        if (is_dir("$root/$writable")) {
            if (@chmod("$root/$writable", 0777)) {
                printMessage("      chmod 0777 $writable" . PHP_EOL);
            } else {
                printError("Operation chmod not permitted for directory $writable.");
            }
        } else {
            printError("Directory $writable does not exist.");
        }
    }
}

function setExecutable($root, $paths): void
{
    foreach ($paths as $executable) {
        if (file_exists("$root/$executable")) {
            if (@chmod("$root/$executable", 0755)) {
                printMessage("      chmod 0755 $executable" . PHP_EOL);
            } else {
                printError("Operation chmod not permitted for $executable.");
            }
        } else {
            printError("$executable does not exist.");
        }
    }
}

function setCookieValidationKey($root, $paths): void
{
    foreach ($paths as $file) {
        printMessage("   generate cookie validation key in $file" . PHP_EOL);
        $file = $root . '/' . $file;
        $length = 32;
        $bytes = openssl_random_pseudo_bytes($length);
        $key = $bytes
                |> base64_encode(...)
                |> (fn($x) => substr($x, 0, $length))
                |> (fn($x) => strtr($x, '+/=', '_-.'));
        $content = preg_replace('/(("|\')cookieValidationKey("|\')\s*=>\s*)(""|\'\')/', "\\1'$key'", file_get_contents($file));
        file_put_contents($file, $content);
    }
}

function createSymlink($root, $links): void
{
    foreach ($links as $link => $target) {
        //first removing folders to avoid errors if the folder already exists
        try {
            FileHelper::removeDirectory($root . "/" . $link);
        } catch (Exception) {
        }
        //next removing existing symlink in order to update the target
        if (is_link($root . "/" . $link)) {
            FileHelper::unlink($root . "/" . $link);
        }
        if (@symlink($root . "/" . $target, $root . "/" . $link)) {
            printMessage("      symlink $root/$target $root/$link" . PHP_EOL);
        } else {
            printError("Cannot create symlink $root/$target $root/$link.");
        }
    }
}

/**
 * Prints error message.
 */
function printError(string $message): void
{
    Console::error(PHP_EOL . 'Error. ' . $message . PHP_EOL);
}

function printMessage(string $message): void
{
    Console::stdout($message);
}

/**
 * Returns true if the stream supports colorization. ANSI colors are disabled if not supported by the stream.
 *
 * - windows without ansicon
 * - not tty consoles
 *
 * @return boolean true if the stream supports ANSI colors, otherwise false.
 */
function ansiColorsSupported(): bool
{
    return DIRECTORY_SEPARATOR === '\\'
        ? getenv('ANSICON') !== false || getenv('ConEmuANSI') === 'ON'
        : function_exists('posix_isatty') && @posix_isatty(STDOUT);
}

/**
 * Get ANSI code of style.
 * @param string $name style name
 * @return integer ANSI code of style.
 */
function getStyleCode(string $name): int
{
    $styles = [
        'bold' => 1,
        'fg-black' => 30,
        'fg-red' => 31,
        'fg-green' => 32,
        'fg-yellow' => 33,
        'fg-blue' => 34,
        'fg-magenta' => 35,
        'fg-cyan' => 36,
        'fg-white' => 37,
        'bg-black' => 40,
        'bg-red' => 41,
        'bg-green' => 42,
        'bg-yellow' => 43,
        'bg-blue' => 44,
        'bg-magenta' => 45,
        'bg-cyan' => 46,
        'bg-white' => 47,
    ];
    return $styles[$name];
}

/**
 * Formats message using styles if STDOUT supports it.
 * @param string $message message
 * @param string[] $styles styles
 * @return string formatted message.
 */
function formatMessage(string $message, array $styles): string
{
    if (empty($styles) || !ansiColorsSupported()) {
        return $message;
    }

    return sprintf("\x1b[%sm", implode(';', array_map('getStyleCode', $styles))) . $message . "\x1b[0m";
}
